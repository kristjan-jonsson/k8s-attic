# Adds a *.{{ domain }} forward to BIND in the RKE2 CoreDNS chart.
# RKE2's chart ignores a "-custom" ConfigMap (that's a k3s feature), so the
# server block has to go through the chart values. Setting `servers` replaces
# the chart default, so the default "." block is repeated here unchanged.
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-coredns
  namespace: kube-system
spec:
  valuesContent: |-
    servers:
    - zones:
      - zone: .
        use_tcp: true
      port: 53
      plugins:
      - name: errors
      - name: health
        configBlock: |-
          lameduck 10s
      - name: ready
      - name: kubernetes
        parameters: in-addr.arpa ip6.arpa
        configBlock: |-
          pods insecure
          fallthrough in-addr.arpa ip6.arpa
          ttl 30
      - name: prometheus
        parameters: 0.0.0.0:9153
      - name: forward
        parameters: . /etc/resolv.conf
      - name: cache
        parameters: 30
      - name: loop
      - name: reload
      - name: loadbalance
    - zones:
      - zone: {{ domain }}.
        use_tcp: true
      port: 53
      plugins:
      - name: errors
      - name: cache
        parameters: 30
      - name: forward
        parameters: . {{ dns_server_ip }}
