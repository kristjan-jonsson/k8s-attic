# Copy to .env and fill in for your machine, then `set -a && source .env && set +a`
# before running ansible-playbook. Leave unset on a non-corporate network.

# Comma-separated macOS Keychain labels for corporate TLS-interception root CA(s)
# trusted via Jamf/MDM. Needed only if outbound HTTPS pulls (registry.k8s.io, docker.io)
# fail with "certificate signed by unknown authority" from inside the kind node.
CORPORATE_CA_KEYCHAIN_LABELS=
